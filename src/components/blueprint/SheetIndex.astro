---
interface Entry {
    number: number;
    title: string;
    href: string;
    note?: string;
}

interface Props {
    entries: Entry[];
    current: number;
}

const {entries, current} = Astro.props;
const pad = (value: number) => String(value).padStart(2, '0');
---

<nav class="index" aria-labelledby="sheet-index-title">
    <p id="sheet-index-title" class="index__title">Sheet index</p>
    <ol class="index__list">
        {
            entries.map((entry) => (
                <li class:list={['index__entry', {'index__entry--current': entry.number === current}]}>
                    <span class="index__number">{pad(entry.number)}</span>
                    <a href={entry.href} aria-current={entry.number === current ? 'page' : undefined}>
                        {entry.title}
                    </a>
                    {entry.note && <span class="index__note">{entry.note}</span>}
                </li>
            ))
        }
    </ol>
</nav>

<style>
    .index {
        display: grid;
        gap: 0.6rem;
        width: 100%;
        max-width: 26rem;
    }

    .index__title {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--color-label);
    }

    .index__list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: var(--rule-strong);
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    .index__entry {
        display: grid;
        grid-template-columns: 3rem 1fr auto;
        gap: 0.75rem;
        align-items: baseline;
        padding-block: 0.75rem;
        border-bottom: var(--rule-strong);
    }

    .index__number {
        color: var(--color-hint);
    }

    .index__entry--current .index__number::before {
        content: '▸ ';
        color: var(--color-text);
    }

    .index__entry a {
        color: var(--color-text);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .index__entry--current a {
        font-weight: 500;
    }

    .index__entry a:hover {
        text-decoration: underline;
        text-underline-offset: 0.3em;
    }

    .index__note {
        font-size: 0.75rem;
        color: var(--color-hint);
    }
</style>
